--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -12,6 +12,7 @@ noinst_HEADERS= libp11-int.h pkcs11.h p1
 include_HEADERS= libp11.h p11_err.h
 
 # Libraries to build (static-engine optional)
+if LIBP11_OSSL_ENGINE
 if ENABLE_STATIC_ENGINE
 lib_LTLIBRARIES = libp11.la libpkcs11.la
 else
@@ -19,6 +20,7 @@ lib_LTLIBRARIES = libp11.la
