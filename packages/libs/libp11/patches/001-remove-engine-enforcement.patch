+	[engine],
+	[AS_HELP_STRING([--enable-engine], [enable engine (pkcs11.so) build @<:@disabled@:>@])],
+	,
+	[enable_engine="true"]
+)
+
+AM_CONDITIONAL([LIBP11_OSSL_ENGINE], [test "$enable_engine" = "true"])
+
 AC_ARG_VAR([DOXYGEN], [doxygen utility])
 AC_CHECK_PROGS([DOXYGEN],[doxygen])
 test "${enable_api_doc}" = "yes" -a -z "${DOXYGEN}" && AC_MSG_ERROR([doxygen is required for API doc])
@@ -329,6 +338,7 @@ Engine directory:        ${enginesexecdi
 Provider directory:      ${providersexecdir}
