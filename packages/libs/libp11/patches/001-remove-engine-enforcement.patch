--- a/Makefile.am
+++ b/Makefile.am
@@ -23,7 +23,7 @@ dist_noinst_DATA = COPYING INSTALL.md
 dist_doc_DATA = NEWS
 
 # Prerequisites must be first on the list
-SUBDIRS = src doc examples tests
+SUBDIRS = src
 
 # Allow detection of packaged tarball
 dist-hook:
--- a/configure.ac
+++ b/configure.ac
@@ -216,6 +216,15 @@ AC_CHECK_HEADERS([ \
 	unistd.h locale.h getopt.h dlfcn.h utmp.h \
 ])
 
